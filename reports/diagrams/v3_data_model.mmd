erDiagram
  Dare ||--o{ Completion : records
  Dare ||--o{ ProgressLog : measures
  Dare ||--o{ ScheduleException : overrides
  Dare ||--o{ FocusSession : times
  Dare {
    Long id PK
    String title
    int targetValue
    String targetUnit
    int weeklyTarget
    String repeatType
    String repeatDays
  }
  Completion {Long id PK; Long dareId FK; date challengeDate}
  ProgressLog {Long id PK; Long dareId FK; date day; int amount; String source}
  ScheduleException {Long id PK; Long dareId FK; date day; String mode}
  FocusSession {Long id PK; Long dareId FK; datetime startedAt; int plannedMinutes; String status}
